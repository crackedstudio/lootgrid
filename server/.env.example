# ---- deployment ----
# Caddy uses this for the Let's Encrypt certificate. MiniPay will not load a
# Mini App over plain HTTP, so this must be a real domain pointing at the VPS.
DOMAIN=lootgrid.example.com

# ---- runtime ----
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# ---- storage ----
# A file. Back it up by copying it (see the runbook for the safe way with WAL).
DATABASE_PATH=/data/lootgrid.db

# ---- auth ----
# chain = verify session keys against PlayerRegistry on Celo.
# dev   = trust the claimed player id. The server REFUSES to boot with this in production.
AUTH_MODE=chain
CHAIN=celo
RPC_URL=https://forno.celo.org
# The PROXY address, not the implementation. The registry is UUPS-upgradeable,
# so the implementation address changes on every upgrade while this stays fixed.
PLAYER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Positive-binding cache. Hard-capped at 60000 — it is the worst-case window in
# which a revoked key still authenticates if the event subscription drops.
REGISTRY_CACHE_MS=60000
# Negative results ("no binding") expire far sooner, so an unauthenticated
# request naming a not-yet-bound address cannot lock that player out of their
# own first login.
REGISTRY_NEGATIVE_CACHE_MS=2000
REQUEST_MAX_SKEW_MS=30000

# ---- on-chain record (optional) ----
# Publishes tile reveals, hunt entries and hunt resolutions to LootGridActions,
# one transaction per action, with no wallet prompt for the player.
#
# Off is a valid production setting: the chain records nothing the server does
# not already own. Turning it on buys a public, timestamped audit trail and
# costs relayer gas per action. Requires AUTH_MODE=chain — under `dev` a player
# id is a made-up string, not an address.
RELAY_ENABLED=false
LOOTGRID_ACTIONS_ADDRESS=0x0000000000000000000000000000000000000000
# Hot key, funded with a small CELO float. Assume it leaks eventually — the
# worst it can do is write false game logs, and the contract owner can rotate it
# in one transaction. NEVER reuse the PlayerRegistry owner key here.
RELAY_PRIVATE_KEY=
RELAY_POLL_MS=1000
RELAY_MAX_IN_FLIGHT=25
# 1 = one transaction per action, which is the whole point. Raise this only if
# relayer gas becomes the binding constraint; it trades transaction count for
# cost roughly linearly.
RELAY_MAX_ATTEMPTS=8

# ---- player-paid records ----
# Set this and players publish their own hunt entries and wins, paying their own
# gas in a Celo fee currency they already hold. The relayer stops enqueueing
# entries and resolutions when it is set (reveals keep relaying either way — the
# tap loop must never wait on a player's wallet).
#
# The server signs an EIP-712 attestation naming the player and the referee's
# numbers; the contract accepts whoever submits it, because that signature is
# the authorisation. Its address goes in the contract's ACTIONS_ATTESTOR.
#
# This key NEVER sends a transaction, so it needs no balance and can live colder
# than RELAY_PRIVATE_KEY. It is the more dangerous of the two: a leak mints
# entries and winning resolutions that anyone can then submit. It must differ
# from RELAY_PRIVATE_KEY, and requires LOOTGRID_ACTIONS_ADDRESS to be set.
# Leave blank to keep the relayer publishing everything, as before.
ATTESTOR_PRIVATE_KEY=

# ---- entry fees (optional, legally gated) ----
# Charges admission to rewarded hunts, over x402: the server answers 402 with a
# payload, the wallet signs one EIP-3009 authorisation, the facilitator settles
# and sponsors the gas. Energy is tried first, so a player with energy never
# sees a price — that free route is deliberate and should stay.
#
# DEFAULT FALSE AND MUST STAY FALSE IN PRODUCTION until the legal review
# returns. Pay-to-enter for a cash prize is the gambling definition in many
# jurisdictions, and this build compounds it: the house charges admission,
# issues the hints, and may deliberately falsify them. See
# docs/AGENTIC_ARCHITECTURE.md §10.
#
# MAINNET ONLY. @x402/evm has no chain id for Celo Sepolia, so there is nothing
# to sign against there; the server reports the feature off rather than failing
# at request time.
ENTRY_FEES_ENABLED=false
# Where fees are collected. Not the facilitator's address — ours.
ENTRY_FEE_PAY_TO=0x0000000000000000000000000000000000000000
# Sent to the Celo facilitator and nowhere else. Never reaches a buyer or the
# client bundle. Optional; without it the facilitator rate-limits harder.
X402_API_KEY=

# ---- hint market (optional) ----
# Lets players sell copies of the hints they hold, through HintEscrow.
#
# The server holds no money on this path: the buyer escrows their own payment,
# either party submits the referee's release, and the hint is granted only once
# the contract says the payment settled. Delivering any earlier would let a buyer
# take the hint, refund at expiry, and keep it.
#
# Needs both signers, and they must be different keys:
#   ATTESTOR_PRIVATE_KEY  vouches that a hint was issued by the game, at a tier.
#                         Authorises nothing financial, so it can stay hot.
#   ESCROW_PRIVATE_KEY    releases a buyer's escrowed money to a seller. Put it
#                         behind a multisig before real money trades.
# Requires AUTH_MODE=chain: trades settle to wallet addresses, and a dev player
# id is not one.
HINT_MARKET_ENABLED=false
HINT_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Must be the token HintEscrow was deployed against. Only used to build the
# buyer's `approve` call.
HINT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# cUSD/USDm are 18, USDC/USDT are 6. Getting this wrong misprices every trade by
# twelve orders of magnitude.
HINT_TOKEN_DECIMALS=18
# How long a funded trade waits for its release before the buyer may refund.
# Must be under the contract's own maxTradeTtl or every fund() reverts.
HINT_TRADE_TTL_SEC=900

# ---- player agents (optional) ----
# Lets a player's agent trade hints for them. This is the feature that puts a
# model in charge of a wallet, so it never switches itself on.
#
# The custody model in one line: **the agent is a spender, never a key holder.**
# It can pay allowlisted addresses, under a per-transaction and a daily cap, and
# it cannot withdraw, raise a limit, block the owner leaving, or survive the
# kill switch by a block. Assume it will one day be talked into trying — the
# question the vault answers is what that costs, not whether it happens.
AGENTS_ENABLED=false
# AgentVaultFactory. The only agent address the server needs to be told: vault
# addresses are read back from it, so this database is never the authority on
# whose money is where.
AGENT_VAULT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# The token vaults hold. Usually the same as the hint market's.
AGENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Derives EVERY agent's signing key: agentKey = keccak(this, playerId). There is
# deliberately no key column in the database, which is backed up by copying a
# file — and an agent is recoverable from this secret alone.
#
# The most dangerous secret here after the escrow treasury. A leak is every
# agent's spending rights at once, bounded per player by their caps, allowlist
# and kill switch. Keep it out of backups. Rotating it re-derives every agent
# address, so every player must re-bind — their transaction, not ours.
# Generate with: openssl rand -hex 32
AGENT_MASTER_KEY=

# Hosted inference. Players do not bring keys, so the house pays and meters it
# per vault. This key never reaches a client bundle, a prompt or an agent config.
#
# Measured August 2026: v4-flash is $0.14/1M in, $0.28/1M out — about 0.27 mills
# per turn, and the phase 6 modules cap their own rounds, so a whole hunt of
# thinking costs roughly a third of a cent. v4-pro is ~3x that for no benefit on
# these games. See server/src/agents/budget.ts for the arithmetic.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Concurrent provider calls across ALL agents — the binding constraint on
# everything agents do, ahead of both cost and the sweep.
#
# Was 4, which sat below the ~6.5 calls/sec a hundred seats need. 8 is a
# starting point, not an answer: the real ceiling is our DeepSeek plan's
# per-account concurrency. Size it against `lootgrid_agent_queue_wait_seconds`
# — raise it until the upper percentiles sit clear of a turn deadline. Depth
# alone will not tell you: it stays flat right up until it does not, and a turn
# that arrives after its deadline is a lost hunt, not a slow one.
AGENT_MAX_IN_FLIGHT=8

# House-funded thinking one agent may draw per day, in mills (1000 = 1 cent).
#
# Deliberately NOT the player's `dailyBudgetCents`. That is the owner's money and
# governs hints; this is ours and governs inference. They shared a ceiling until
# seats landed, which meant a player raising their hint budget silently
# authorised more house spending — AGENTS_BYO §7.5(4).
#
# A rate limit, not the exposure bound: the seat is the prepaid total and caps
# what the house can lose. This stops one looping agent drinking a seat in an
# afternoon. ~20,000 mills is about 57 hunts a day at the measured ~350/hunt.
AGENT_HOUSE_DAILY_MILLS=20000

# ---- cors ----
# Explicit origins required in production; `*` is refused.
CORS_ORIGINS=https://lootgrid.example.com

# ---- limits ----
# Applied per-IP BEFORE authentication does any signature recovery or RPC work.
# Reverse-proxy hop count. MUST match reality — `true` would trust a client-
# supplied X-Forwarded-For and make every per-IP limit attacker-controlled.
TRUST_PROXY_HOPS=1
RATE_PREAUTH_PER_MIN=60
RATE_GLOBAL_PER_MIN=600
RATE_TILE_PER_MIN=120
RATE_ATTEMPT_PER_MIN=30
# Market writes. Tighter than gameplay: each one signs an attestation or reads
# the chain, and an order book is the cheapest surface on which to be noisy.
RATE_MARKET_PER_MIN=60
WS_MAX_CONNECTIONS_PER_PLAYER=3
WS_MAX_MESSAGE_BYTES=8192
WS_HEARTBEAT_MS=30000

# ---- observability ----
METRICS_ENABLED=true
# Required in production when metrics are on. Generate with: openssl rand -hex 32
METRICS_TOKEN=
