{
  "name": "lootgrid-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LOOTGRID game referee — server-authoritative fog, energy and races",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && npm run bundle && npm run copy:migrations",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "copy:migrations": "node -e \"require('fs').cpSync('src/db/migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "start:tsx": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:dev": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@x402/core": "^2.22.0",
    "@x402/evm": "^2.22.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "viem": "^2.21.55",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
