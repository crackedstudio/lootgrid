# ═════════════════════════════════════════════════════════════════════════════
#  LOOTGRID — contracts/.env TEMPLATE  (copy to .env; that copy is gitignored)
#
#  THREE SECTIONS. You only ever edit SECTION 1.
#    1  YOUR KEYS      paste them here
#    2  DERIVED        `bash script/derive-env.sh` fills these in
#    3  WIRING         never edit; it just points the scripts at 1 and 2
#
#  Then:  bash script/preflight.sh     must be clean before you broadcast.
#  THIS file is committed — never put a key or a funded address in it.
# ═════════════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════════════
#  SECTION 1 — YOUR KEYS.  ◀── THE ONLY PART YOU EDIT
# ═════════════════════════════════════════════════════════════════════════════

# ── private keys (0x + 64 hex chars) ─────────────────────────────────────────
# Six keys, all different. Paste and stop — derive-env.sh works out the
# addresses, so you never have to match a key to an address by hand.

# Pays gas to deploy. Keeps no authority afterwards. FUND WITH CELO.
DEPLOYER_KEY=

# Hot. Writes game records. Worst case if leaked: false game logs. FUND WITH CELO.
RELAYER_KEY=

# Cold — never sends a transaction, needs no balance.
# Signs game records + hint vouches.
ATTESTOR_KEY=

# Cold — never sends a transaction. THE CROWN JEWEL: signs payouts, hint
# releases and bond slashes. If you have one hardware wallet, use it for this.
ESCROW_SIGNER_KEY=

# Holds the prize float. FUND WITH CELO + the stablecoin.
# Keep the balance small and top it up; this is the only unbounded loss.
ESCROW_TREASURY_KEY=

# The treasury agent. Bounded by caps and the 48h delay.
TREASURY_PROPOSER_KEY=

# ── addresses (no private key — these are not EOAs you sign with) ────────────

# Your Safe multisig. Owns and can rotate everything. NOT an EOA: the deploy
# scripts refuse an owner with no code, and on mainnet that check is the point.
OWNER=

# Can pause during an incident. Needs to be reachable at 3am, so a hardware EOA
# is fine here — it can only ever stop things, never move money.
GUARDIAN=

# The stablecoin everything settles in.
#   cUSD 0x765DE816845861e75A25fCA122bb6898B8B1282a  (18dp) ← amounts assume this
#   USDC 0xcebA9300f2b948710d2653dD7B07f33A8B32118C  ( 6dp) ← divide amounts by 1e12
TOKEN=0x765DE816845861e75A25fCA122bb6898B8B1282a

# LEAVE BLANK until step 4. Deploy Treasury, then paste its address here —
# HintEscrow's rake and HintBond's slashes both pay into it.
TREASURY=


# ═════════════════════════════════════════════════════════════════════════════
#  SECTION 2 — DERIVED.  Run: bash script/derive-env.sh
#  Do not hand-edit. A typo here silently points a contract at a key you do
#  not hold, and nothing will tell you until a signature fails to verify.
# ═════════════════════════════════════════════════════════════════════════════
RELAYER_ADDR=
ATTESTOR_ADDR=
ESCROW_SIGNER_ADDR=
ESCROW_TREASURY_ADDR=
PROPOSER_ADDR=


# ═════════════════════════════════════════════════════════════════════════════
#  SECTION 3 — WIRING.  Never edit.
#  Each deploy script wants its own variable names; these just point them at
#  what you set above. This is why one address can serve six roles without you
#  pasting it six times.
# ═════════════════════════════════════════════════════════════════════════════

CELO_RPC_URL=https://forno.celo.org
CELOSCAN_API_KEY=

# 1. PlayerRegistry ── script/Deploy.s.sol ── use the PROXY address it prints.
#    Upgrades are timelocked 48h. ALERT ON UpgradeProposed before you deploy.
REGISTRY_OWNER=${OWNER}

# 2. AgentVaultFactory ── no arguments, no privileges, nothing to configure.

# 3. LootGridActions ── script/DeployActions.s.sol
ACTIONS_OWNER=${OWNER}
ACTIONS_RELAYER=${RELAYER_ADDR}
ACTIONS_ATTESTOR=${ATTESTOR_ADDR}

# 4. Treasury ── script/DeployTreasury.s.sol ── DEPLOY BEFORE 6 AND 7.
TREASURY_TOKEN=${TOKEN}
TREASURY_OWNER=${OWNER}
TREASURY_PROPOSER=${PROPOSER_ADDR}
TREASURY_GUARDIAN=${GUARDIAN}
# A floor the agent can never allocate below. MUST cover every prize already
# promised — 0 is only right while nothing is owed.
TREASURY_RESERVE=0
TREASURY_PER_PROPOSAL=100000000000000000000
TREASURY_PER_DAY=500000000000000000000
TREASURY_DELAY=172800
# Allowlist starts EMPTY. Call setTarget() or the agent can send money nowhere.

# 5. LootGridEscrow ── script/DeployEscrow.s.sol
ESCROW_TOKEN=${TOKEN}
ESCROW_OWNER=${OWNER}
ESCROW_TREASURY=${ESCROW_TREASURY_ADDR}
ESCROW_ATTESTOR=${ESCROW_SIGNER_ADDR}
ESCROW_GUARDIAN=${GUARDIAN}
# 50 / 500 cUSD. These bound what a leaked signer drains before you notice.
ESCROW_PER_HUNT_CAP=50000000000000000000
ESCROW_PER_DAY_CAP=500000000000000000000
# 24h — your entire window to halt a bad payout.
ESCROW_CHALLENGE_WINDOW=86400
# ESCROW_TREASURY must approve() the escrow before the first fundHunt.

# 6. HintEscrow ── script/DeployHintEscrow.s.sol
HINT_TOKEN=${TOKEN}
HINT_OWNER=${OWNER}
HINT_TREASURY=${TREASURY}
# Vouching authorises nothing financial, so it shares the attestor key by design.
HINT_VOUCH_ATTESTOR=${ATTESTOR_ADDR}
# Moves a buyer's money — must differ from the vouch key, or one leak both
# fabricates what may be sold and pays for it.
HINT_RELEASE_ATTESTOR=${ESCROW_SIGNER_ADDR}
HINT_GUARDIAN=${GUARDIAN}
HINT_RAKE_BPS=250
HINT_MIN_TRADE=10000000000000000
HINT_PER_TRADE_CAP=5000000000000000000
HINT_RAKE_WAIVER=50000000000000000
# SHORT on purpose, unlike the escrow window above: it RESTARTS on every credit,
# so a long one permanently freezes a busy seller and your own rake.
HINT_CHALLENGE_WINDOW=600
HINT_MAX_TTL=86400

# 7. HintBond ── script/DeployHintBond.s.sol
BOND_TOKEN=${TOKEN}
BOND_OWNER=${OWNER}
BOND_SLASH_ATTESTOR=${ESCROW_SIGNER_ADDR}
BOND_GUARDIAN=${GUARDIAN}
# Slashed money funds prizes; any other destination pays someone to find sellers guilty.
BOND_BENEFICIARY=${TREASURY}
# Must outlast a hunt PLUS its verdict window, or: bond, sell false hints, exit.
BOND_WITHDRAW_DELAY=604800
BOND_MIN=25000000000000000000
